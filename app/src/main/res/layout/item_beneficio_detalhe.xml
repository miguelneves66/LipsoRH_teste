<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Ícone Circular à Esquerda -->
        <View
            android:id="@+id/viewCircle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/fundo_circulo_cinza" />

        <ImageView
            android:id="@+id/imgBeneficioIcone"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignTop="@id/viewCircle"
            android:layout_alignBottom="@id/viewCircle"
            android:layout_alignStart="@id/viewCircle"
            android:layout_alignEnd="@id/viewCircle"
            android:layout_centerInParent="true"
            android:padding="5dp"
            android:src="@drawable/ic_medico" />

        <!-- Textos Centrais -->
        <LinearLayout
            android:id="@+id/containerTextos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/viewCircle"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloBeneficio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Convênio Médico"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloBeneficio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plano de saúde para você e seus dependentes."
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver detalhes"
                android:textColor="#A52A2A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Status Tag (Ativo) -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="#E8F5E9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Ativo"
            android:textColor="#4CAF50"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Botões de Ação Inferiores -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/containerTextos"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:background="@drawable/shape_button_border_red"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#A52A2A"
                android:textSize="11sp" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_button_solid_red"
                android:text="Solicitar alteração"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>